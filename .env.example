# --------------------------------------------------
# Scribo Telegram Bot configuration (.env)
# --------------------------------------------------

# 1. Telegram bot token (issued by BotFather)
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 2. Authorised Telegram user ID
# Your numeric Telegram ID, so only you can use the bot (ask @userinfobot for it).
ALLOWED_USER_ID=your_telegram_id_here
# Separate several users with commas: ALLOWED_USER_ID=123456,789012
# Left empty, the bot answers nobody. Open it to everyone with ALLOW_ALL_USERS=true.
ALLOW_ALL_USERS=false

# 3. Google AI Studio API key (Free Tier)
# Available free of charge from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# 4. OpenRouter API key (paid fallback)
# Available from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 5. Default AI provider (google or openrouter)
# Note: on the Google Free Tier ($0) your data may be processed anonymised for
# Google product development. For sensitive material prefer
# DEFAULT_PROVIDER=openrouter (or a paid Google tier).
DEFAULT_PROVIDER=google

# 6. Models to use
GOOGLE_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=google/gemini-3.6-flash

# 7. Language of the interface and of the answers (tr or en)
# Drives both the Telegram messages and the prompts sent to the model, so it is
# what decides which language the bot answers in. Unset or unknown means Turkish.
# LANG is honoured too (LANG=en ./scribo), but prefer SCRIBO_LANG here: a LANG
# line in this file is ignored whenever your shell already exports one.
SCRIBO_LANG=tr

# 8. Paid spending ceiling (USD, covers OpenRouter calls only)
# Once the ceiling is reached no paid call is made; the Google Free Tier is
# unaffected. Left empty there is no ceiling. The counter is written to
# HISTORY_FILE, so it survives a restart for the rest of the calendar day/month.
DAILY_COST_LIMIT=
MONTHLY_COST_LIMIT=

# 8b. Output history (JSONL)
# Every produced output is appended to this file as one line; /son replays the
# most recent one, and the spending counter is restored from here on startup.
# Left undefined, the default file (scribo_history.jsonl) is used.
# To turn history off entirely, set an empty value — the ceiling then resets too.
HISTORY_FILE=scribo_history.jsonl

# 9. Concurrency limit (maximum media files processed at the same time)
# A semaphore worker pool keeps the server from being overloaded and the API
# rate limits from being hit. Requests beyond the limit queue up and wait.
MAX_CONCURRENT_JOBS=5

# 10. Container-only settings — ignored when you run the binary directly.
# The image already defaults all three, so leave them alone unless you need them.

# Timezone. The spending ceilings above roll over on local calendar boundaries,
# so this is what decides the hour your daily cap resets at. The image defaults
# to UTC; set your own zone if that is not what you want.
TZ=Europe/Istanbul

# Ownership the container gives /data before dropping root. Only matters with a
# bind mount: set these to the user that owns the host directory, or chown that
# directory to 1000:1000. Irrelevant for the default named volume.
PUID=1000
PGID=1000
